---
/**
 * 固定ヘッダー。ロゴ+メニューボタン、全画面オーバーレイナビ。
 * mix-blend-difference は視認性が壊れやすいため使わず、
 * 細い下地(グラデーション)で写真上でも読めるようにする。
 */
const nav = [
  { href: '/about/', label: 'ニショイについて', en: 'About' },
  { href: '/events/', label: 'イベント', en: 'Events' },
  // { href: '/journal/', label: '記録', en: 'Journal' }, // 記事が揃うまで非表示
  { href: '/works/', label: 'Web制作', en: 'Works' },
  { href: '/contact/', label: 'お問い合わせ', en: 'Contact' },
];
const current = Astro.url.pathname;
---

<header class="site-header">
  <a class="logo" href="/">NISHYOI</a>
  <button
    id="menu-btn"
    class="menu-btn"
    type="button"
    aria-expanded="false"
    aria-controls="menu-overlay"
  >
    <span class="lines" aria-hidden="true"><i></i><i></i></span>
    <span class="t-label" style="letter-spacing:.2em;">MENU</span>
  </button>
</header>

<div id="menu-overlay" class="overlay" hidden>
  <nav aria-label="メインナビゲーション">
    <ul>
      {nav.map((item, i) => (
        <li style={`--stagger:${i * 60}ms`}>
          <a
            href={item.href}
            aria-current={current.startsWith(item.href) ? 'page' : undefined}
          >
            <span class="en">{item.en}</span>
            <span class="ja">{item.label}</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>
  <div class="overlay-foot">
    <a href="https://www.instagram.com/nishyoi/" target="_blank" rel="noopener">Instagram @nishyoi</a>
    <a href="https://kotograph-joe.com/" target="_blank" rel="noopener">KOTOGRAPH</a>
  </div>
</div>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.1rem clamp(1.5rem, 4vw, 3rem);
    pointer-events: none;
  }
  /* スクロールで本文がヘッダーの下を通るとき、ロゴ・MENUと文字が重なって
     読めなくなるのを防ぐ下地。明るい地の上でだけ敷く
     (暗い地=ヒーロー写真の上には、写真側に別の下地がある)。 */
  .site-header::before {
    content: "";
    position: absolute;
    inset: 0 0 auto 0;
    height: 6.5rem;
    /* var(--color-paper) = #f7f4ee。ロゴ・MENUの行までは不透明にして、
       その下でゆるやかに透過させる */
    background: linear-gradient(
      to bottom,
      rgba(247, 244, 238, 1) 0%,
      rgba(247, 244, 238, 1) 56%,
      rgba(247, 244, 238, 0) 100%
    );
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.35s var(--ease-river);
  }
  :global(:root[data-nav="onlight"]) .site-header::before { opacity: 1; }
  @media (prefers-reduced-motion: reduce) {
    .site-header::before { transition: none; }
  }
  /* ロゴとメニューは、背後の明暗に合わせて黒/白へ切り替える(下のscript) */
  .logo, .menu-btn {
    position: relative;
    pointer-events: auto;
    color: var(--color-ink);
    transition: color 0.35s var(--ease-river);
  }
  :global(:root[data-nav="ondark"]) .logo,
  :global(:root[data-nav="ondark"]) .menu-btn {
    color: var(--color-paper);
  }
  .logo {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    letter-spacing: 0.42em;
    text-decoration: none;
  }
  .menu-btn {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.4rem 0;
  }
  .menu-btn .t-label { color: inherit; }
  @media (prefers-reduced-motion: reduce) {
    .logo, .menu-btn { transition: none; }
  }
  .menu-btn .lines { display: grid; gap: 6px; width: 26px; }
  .menu-btn .lines i {
    display: block;
    height: 1px;
    background: currentColor;
    transition: transform var(--dur-micro) var(--ease-river);
  }
  .menu-btn[aria-expanded="true"] .lines i:first-child { transform: translateY(3.5px) rotate(45deg); }
  .menu-btn[aria-expanded="true"] .lines i:last-child { transform: translateY(-3.5px) rotate(-45deg); }

  .overlay {
    position: fixed;
    inset: 0;
    z-index: 40;
    background: var(--color-paper);
    display: grid;
    grid-template-rows: 1fr auto;
    place-items: center;
    opacity: 0;
    transition: opacity var(--dur-move) var(--ease-river);
  }
  .overlay.is-open { opacity: 1; }
  .overlay ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: clamp(var(--sp-2), 3.5vh, var(--sp-3));
    text-align: center;
  }
  .overlay li {
    opacity: 0;
    transform: translateY(10px);
    transition: opacity var(--dur-move) var(--ease-river), transform var(--dur-move) var(--ease-river);
    transition-delay: var(--stagger, 0ms);
  }
  .overlay.is-open li { opacity: 1; transform: none; }
  .overlay a {
    text-decoration: none;
    display: grid;
    gap: 0.15rem;
  }
  .overlay a .en {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--color-river);
  }
  .overlay a .ja {
    font-family: var(--font-serif);
    font-size: clamp(1.2rem, 3vh, 1.5rem);
    letter-spacing: 0.22em;
  }
  .overlay a[aria-current="page"] .ja { color: var(--color-ink-soft); }
  .overlay a:hover .ja { color: var(--color-river); }
  .overlay-foot {
    padding-bottom: var(--sp-4);
    display: flex;
    gap: var(--sp-4);
  }
  .overlay-foot a {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    color: var(--color-ink-soft);
    text-decoration: none;
  }
  .overlay-foot a:hover { color: var(--color-river); }

  @media (prefers-reduced-motion: reduce) {
    .overlay, .overlay li, .menu-btn .lines i { transition: none; }
  }
</style>

<script>
  const btn = document.getElementById('menu-btn') as HTMLButtonElement;
  const overlay = document.getElementById('menu-overlay') as HTMLElement;
  let open = false;

  function setOpen(next: boolean) {
    open = next;
    btn.setAttribute('aria-expanded', String(open));
    if (open) {
      overlay.hidden = false;
      requestAnimationFrame(() => overlay.classList.add('is-open'));
      document.body.style.overflow = 'hidden';
      (overlay.querySelector('a') as HTMLElement | null)?.focus();
    } else {
      overlay.classList.remove('is-open');
      document.body.style.overflow = '';
      // transitionendが発火しない環境(reduced-motion等)でも必ず閉じ切る
      let closed = false;
      const done = () => {
        if (closed) return;
        closed = true;
        overlay.hidden = true;
      };
      overlay.addEventListener('transitionend', done, { once: true });
      setTimeout(done, 600);
      btn.focus();
    }
    updateNav(); // 開閉に合わせてヘッダー文字色も更新
  }

  btn.addEventListener('click', () => setOpen(!open));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && open) setOpen(false);
    // 簡易フォーカストラップ
    if (e.key === 'Tab' && open) {
      const focusables = [btn, ...overlay.querySelectorAll<HTMLElement>('a')];
      const first = focusables[0]!;
      const last = focusables[focusables.length - 1]!;
      if (e.shiftKey && document.activeElement === first) { last.focus(); e.preventDefault(); }
      else if (!e.shiftKey && document.activeElement === last) { first.focus(); e.preventDefault(); }
    }
  });

  // ── ヘッダーの文字色を、背後の明暗に合わせて黒/白へ切り替える ──
  // 暗い背景の要素だけ data-nav-bg="dark" を付けておき、ヘッダー中央線に
  // その要素が重なっている間だけ文字を明色(paper)にする。
  const root = document.documentElement;
  function updateNav() {
    // メニューを開いている間は明色の地(overlay)なので黒文字
    if (open) { root.dataset.nav = 'onlight'; return; }
    const line = 28; // ヘッダーのおおよその中心Y
    let onDark = false;
    for (const el of document.querySelectorAll('[data-nav-bg="dark"]')) {
      const r = el.getBoundingClientRect();
      if (r.top <= line && r.bottom > line) { onDark = true; break; }
    }
    root.dataset.nav = onDark ? 'ondark' : 'onlight';
  }
  let ticking = false;
  function onScroll() {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(() => { updateNav(); ticking = false; });
  }
  window.addEventListener('scroll', onScroll, { passive: true });
  window.addEventListener('resize', updateNav);
  window.addEventListener('load', updateNav); // スクロール位置復元後にも反映
  updateNav();
</script>
