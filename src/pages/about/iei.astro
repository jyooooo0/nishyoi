---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import AboutNav from '../../components/AboutNav.astro';
import ieiData from '../../data/iei.json';

const description =
  '集落の遺影。丈が撮り続けている、いつか無くなるかもしれない関川の記録。しな織の手仕事、住民、祭り、四季、そして朽ちていく家々を、季節順に。';

// 画像を読み込み、iei.json(撮影日順)に並べる
const files = import.meta.glob<{ default: ImageMetadata }>('../../assets/iei/*.jpg', { eager: true });
const byName: Record<string, ImageMetadata> = {};
for (const [path, mod] of Object.entries(files)) {
  byName[path.split('/').pop()!] = mod.default;
}

// 撮影年は出さず、季節順(月日)に並べる。春→夏→秋→冬(立春起点)
const SEASONS = [
  { key: 'spring', label: '春', months: [3, 4, 5] },
  { key: 'summer', label: '夏', months: [6, 7, 8] },
  { key: 'autumn', label: '秋', months: [9, 10, 11] },
  { key: 'winter', label: '冬', months: [12, 1, 2] },
] as const;
const seasonOf = (m: number) => SEASONS.find((s) => s.months.includes(m))!;
// 並び順キー: 3月=0 … 翌2月=11 で円環を作る
const orderKey = (m: number, d: number) => ((m - 3 + 12) % 12) * 100 + d;

type Shot = { img: ImageMetadata; month: number; day: number; alt: string };
const shots: Shot[] = ieiData
  .map((entry) => {
    const date = new Date(entry.date);
    const m = date.getMonth() + 1;
    return {
      img: byName[entry.src]!,
      month: m,
      day: date.getDate(),
      alt: `関川の記録(${seasonOf(m).label})`,
    };
  })
  .filter((s) => s.img)
  .sort((a, b) => orderKey(a.month, a.day) - orderKey(b.month, b.day));

// 季節ごとにまとめる
const bySeason = SEASONS.map((s) => ({
  label: s.label,
  shots: shots.filter((x) => s.months.includes(x.month)),
})).filter((g) => g.shots.length > 0);
---

<Base title="集落の遺影" description={description}>
  <article class="iei">
    <header class="container head">
      <div class="heading-pair">
        <span class="en">Portraits of a Vanishing Village</span>
        <h1 class="t-display">集落の遺影</h1>
      </div>
      <AboutNav />
      <p class="lead">
        いつか無くなるかもしれない。そう言われる関川を、私は2016年から撮り続けています。
        しな織の手仕事、そこに暮らす人、祭り、めぐる季節、そして雪の重みで朽ちていく家々。
        いま確かにここにある暮らしの姿を、遺影のように残しておきたいと思っています。
      </p>
      <p class="count t-data">全{shots.length}点 / 春夏秋冬</p>
    </header>

    {bySeason.map(({ label, shots }) => (
      <section class="year-block">
        <div class="container">
          <h2 class="year-label t-data">{label}</h2>
          <div class="sheet">
            {shots.map((s) => (
              <figure class="frame reveal">
                <Image
                  src={s.img}
                  alt={s.alt}
                  widths={[400, 800, 1200]}
                  sizes="(max-width: 40rem) 45vw, (max-width: 64rem) 30vw, 22vw"
                  loading="lazy"
                />
              </figure>
            ))}
          </div>
        </div>
      </section>
    ))}

    <div class="container next">
      <a class="link-line" href="/about/sekigawa/">関川集落について <span aria-hidden="true">→</span></a>
      <a class="link-line" href="https://kotograph-joe.com/" target="_blank" rel="noopener">KOTOGRAPH(写真の仕事) <span aria-hidden="true">↗</span></a>
    </div>
  </article>
</Base>

<style>
  .iei { padding-block: calc(var(--space-section) + var(--sp-4)) var(--space-section); }
  .head { display: grid; gap: var(--sp-4); margin-bottom: var(--sp-5); }
  .lead {
    font-size: 0.95rem;
    color: var(--color-ink-soft);
    line-height: 2.4;
    max-width: 40em;
  }
  .count { color: var(--color-river); letter-spacing: 0.2em; }

  .year-block { padding-block: var(--sp-4); }
  .year-label {
    color: var(--color-ink-soft);
    letter-spacing: 0.3em;
    border-top: 1px solid var(--line);
    padding-top: var(--sp-2);
    margin-bottom: var(--sp-3);
  }
  /* コンタクトシート: 縦横混在をカラムで自然に流す */
  .sheet {
    columns: 4 16rem;
    column-gap: var(--sp-2);
  }
  @media (max-width: 40rem) { .sheet { columns: 2 9rem; } }
  .frame {
    break-inside: avoid;
    margin: 0 0 var(--sp-2);
    border: 1px solid var(--line);
    background: var(--color-paper);
    padding: 0.35rem;
  }
  .frame :global(img) {
    width: 100%;
    height: auto;
    display: block;
  }

  .next {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-4);
    margin-top: var(--space-section);
  }
</style>
