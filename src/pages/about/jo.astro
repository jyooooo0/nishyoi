---
import Base from '../../layouts/Base.astro';
import AboutNav from '../../components/AboutNav.astro';
import PhotoFrame from '../../components/PhotoFrame.astro';
import RiverLine from '../../components/RiverLine.astro';
import joPortrait from '../../assets/photos/jo-portrait.jpg';
import joSnow from '../../assets/photos/jo-snow.jpg';

const description =
  '五十嵐 丈(Jo Igarashi)。1993年、山形県鶴岡市関川生まれ。写真家として活動しながら、生まれ育った集落で暮らしを起点にしたニショイを始めている。';

const timeline = [
  { year: '1993', body: '山形県鶴岡市関川に生まれる' },
  { year: '2012', body: '大学進学を機に、一度地域を離れる' },
  { year: '2013', body: '在学中から、しな織祭りの手伝いで関川に帰るようになる' },
  { year: '2015', body: '大学4年。地域おこし協力隊の人たちと一緒に、地域の活動に携わる(給与は補助金)' },
  { year: '2016', body: '卒業。補助金による給与が終わったのを機に、地域の銀行に勤める。この頃から、集落の写真を撮りはじめる(集落の遺影)' },
  { year: '2017', body: '銀行を離れ、自然体験や、シナノキの花を使ったコスメの地域事業に携わる' },
  { year: '2026', body: '生まれ育った関川で、暮らしを起点にニショイを始める' },
];

/* 後半: 物語(音声で聞き取った内容の草稿。細かな文言は本人が改稿予定) */
const story = [
  {
    title: '「何のために生きるのか」',
    body: '中学生の頃、部活に挫折したのをきっかけに、「自分は何のために生きるのか」を考えた時期がありました。明確な答えは、正直いまも出ていません。ただ、少なくとも今の自分があるのは、家族と、自分の家の子供のようにかわいがってくれた近所の人たちのおかげだと思っています。この地域に恩返しがしたい。それが、すべての原点です。',
  },
  {
    title: '帰ってきただけで偉い',
    body: '大学生になってからは、しな織祭りを手伝いに関川へ帰るようになりました。「お前は帰ってきただけで偉い」。そう言って迎えてくれる地域です。ここに何かを返すことは、誰かのためであると同時に、自分自身の生きる目的にもなる。そう考えるようになりました。',
  },
  {
    title: 'お金の流れを知る',
    body: '地元に帰るには、まず生活の基盤が要ります。大学4年の頃は、地域おこし協力隊の人たちと一緒に、地域の活動に携わっていました。給与は補助金でまかなわれていて、その補助金がなくなったタイミングで、地域の銀行に就職しました。「まずはお金の流れを知るのがいいだろう」という思いもありました。',
  },
  {
    title: '山間部がなくなる構造',
    body: '銀行の仕事には、面白い部分もたくさんありました。けれど、街でお金を稼ぐ仕組みがある一方で、山にはお金が返ってこない。これは山間部がなくなっていく構造そのものであり、自分もそれに加担している。そう気づいて、一年ほどで退職しました。山にあるものから売上をつくらなければ、集落は続いていかない。それが、このとき見えたことです。ちょうど同じ頃から、いつか無くなるかもしれない集落の姿を、写真に撮りはじめました。',
  },
  {
    title: '暮らしそのものを組み替える',
    body: 'その後は、自然体験の仕事や、シナノキに咲く花を使ったコスメの製造販売に携わりました。生活はできていましたが、肝心の「暮らしの時間」を大切にすることが、なかなかできませんでした。だからいまは、ライフスタイルそのものを組み替えて、暮らしを起点に新しい形を試す。ニショイの活動に軸足を移しています。',
  },
];
---

<Base title="丈のプロフィール" description={description}>
  <article class="jo">
    <header class="container head">
      <div class="heading-pair">
        <span class="en">Profile</span>
        <h1 class="t-display">五十嵐 丈</h1>
        <p class="t-data" style="letter-spacing:.24em; color:var(--color-ink-soft);">JO IGARASHI / PHOTOGRAPHER</p>
      </div>
      <AboutNav />
    </header>

    <!-- 前段: すぐ分かる要約 -->
    <div class="container main-grid">
      <div class="photos">
        <PhotoFrame
          ratio="4/5"
          src={joPortrait}
          alt="五十嵐丈のポートレート"
          focal="50% 38%"
          sizes="(max-width: 48rem) 90vw, 24rem"
        />
        <PhotoFrame
          ratio="4/5"
          src={joSnow}
          alt="雪の森に立ち、木々を見上げる(冬撮影)"
          focal="50% 45%"
          class="photo-sub"
          sizes="(max-width: 48rem) 70vw, 18rem"
        />
      </div>

      <div class="text">
        <p class="bio reveal">
          1993年、鶴岡市関川生まれ。大学進学で一度地域を離れ、卒業後は銀行勤務を経験。
          その後、自然体験プログラムや、しな織・しなの花を活用した地域事業に携わる。
          現在はそれらのプロジェクトを離れ、写真家として活動しながら、
          生まれ育った集落で、暮らしそのものを起点にした<a href="/about/">ニショイ</a>を始めている。
        </p>

        <div class="tl reveal" style="--stagger:90ms">
          <h2 class="t-label" style="margin-bottom: var(--sp-2);">Timeline</h2>
          <ol class="tl-list">
            {timeline.map((t) => (
              <li>
                <span class="t-data year">{t.year || '—'}</span>
                <span class="body">{t.body}</span>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </div>

    <RiverLine variant={2} />

    <!-- 後半: 詳細の物語。最後はニショイの活動へつながる -->
    <div class="container story">
      <div class="heading-pair reveal">
        <span class="en">Story</span>
        <h2 class="t-section">ここまでの道のり</h2>
      </div>
      <p class="story-intro reveal">
        いま考えていることは<a href="/about/">ニショイについて</a>にまとめました。
        ここでは、その手前にある、個人的な道のりを。
      </p>
      {story.map((s, i) => (
        <section class="chapter reveal" style={`--stagger:${(i % 2) * 90}ms`}>
          <h3>{s.title}</h3>
          <p>{s.body}</p>
        </section>
      ))}
      <p class="to-nishyoi reveal">
        この続きは、ニショイの活動そのものです。
      </p>

      <section class="family reveal">
        <h3 class="fam-h">家族</h3>
        <p class="fam-intro">いまは、この家族で暮らしています。</p>
        <dl class="fam-list">
          <div>
            <dt>オット</dt>
            <dd><span class="fam-name">五十嵐 丈</span></dd>
          </div>
          <div>
            <dt>ツマ</dt>
            <dd><span class="fam-name">五十嵐 颯稀</span><span class="fam-rd">さつき</span></dd>
          </div>
          <div>
            <dt>チョウナン</dt>
            <dd>
              <span class="fam-name">五十嵐 旦旦</span><span class="fam-rd">たんたん / 保護猫</span>
              <span class="fam-note">2024年の元旦、妻の実家に帰省した初日の出の朝、ひとりで歩いていたところを保護しました。</span>
            </dd>
          </div>
          <div>
            <dt>ジナン</dt>
            <dd>
              <span class="fam-name">五十嵐 菅菅</span><span class="fam-rd">かんかん / 保護猫</span>
              <span class="fam-note">2025年10月ごろ、菅野代のトンネルのあたりに、ふらりと現れるようになりました。</span>
            </dd>
          </div>
          <div>
            <dt>サンナン</dt>
            <dd>
              <span class="fam-name">五十嵐 希糸</span><span class="fam-rd">きいと</span>
              <span class="fam-note">2026年5月に生まれました。</span>
            </dd>
          </div>
        </dl>
      </section>

      <div class="links reveal">
        <a class="link-line" href="/about/iei/">集落の遺影(写真) <span aria-hidden="true">→</span></a>
        <a class="link-line" href="/about/">ニショイについて <span aria-hidden="true">→</span></a>
        <a class="link-line" href="https://kotograph-joe.com/" target="_blank" rel="noopener">KOTOGRAPH(写真の仕事) <span aria-hidden="true">↗</span></a>
        <a class="link-line" href="https://note.com/joe_igarashi" target="_blank" rel="noopener">note <span aria-hidden="true">↗</span></a>
        <a class="link-line" href="https://www.instagram.com/nishyoi/" target="_blank" rel="noopener">Instagram <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </article>
</Base>

<style>
  .jo { padding-block: calc(var(--space-section) + var(--sp-4)) var(--space-section); }
  .head { display: grid; gap: var(--sp-4); margin-bottom: var(--sp-5); }
  .main-grid {
    display: grid;
    grid-template-columns: minmax(0, 24rem) 1fr;
    gap: clamp(var(--sp-4), 6vw, var(--sp-6));
    align-items: start;
    margin-bottom: var(--sp-4);
  }
  @media (max-width: 48rem) {
    .main-grid { grid-template-columns: 1fr; }
  }
  .photos { display: grid; gap: var(--sp-3); }
  /* 2枚目を右へずらして重なりのリズムを作る */
  .photo-sub { margin-left: 22%; margin-top: calc(-1 * var(--sp-4)); }

  .text { display: grid; gap: var(--sp-4); max-width: 40em; }
  .bio {
    font-size: 0.95rem;
    line-height: 2.4;
    letter-spacing: 0.04em;
  }
  .bio a { color: var(--color-river); text-underline-offset: 4px; }
  .tl-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
  }
  .tl-list li {
    display: grid;
    grid-template-columns: 4.5rem 1fr;
    gap: var(--sp-2);
    padding-block: var(--sp-1);
    border-top: 1px solid var(--line);
    font-size: 0.85rem;
    line-height: 2;
  }
  .tl-list li:last-child { border-bottom: 1px solid var(--line); }
  .tl-list .year { color: var(--color-river); align-self: baseline; padding-top: 0.3em; }
  .tl-list .body { color: var(--color-ink-soft); }

  .story {
    display: grid;
    gap: var(--sp-4);
    max-width: 46rem;
    margin-top: var(--sp-4);
  }
  .story-intro { font-size: 0.9rem; color: var(--color-ink-soft); line-height: 2.2; }
  .story-intro a { color: var(--color-river); text-underline-offset: 4px; }
  .chapter { display: grid; gap: var(--sp-2); }
  .chapter h3 {
    font-family: var(--font-serif);
    font-size: 1.1rem;
    letter-spacing: 0.12em;
  }
  .chapter p {
    font-size: 0.92rem;
    color: var(--color-ink-soft);
    line-height: 2.3;
    max-width: 40em;
  }
  .to-nishyoi {
    font-family: var(--font-serif);
    font-size: 1rem;
    letter-spacing: 0.1em;
    padding-top: var(--sp-2);
  }

  /* 家族 */
  .family { display: grid; gap: var(--sp-3); padding-top: var(--sp-2); }
  .fam-h {
    font-family: var(--font-serif);
    font-size: 1.1rem;
    letter-spacing: 0.14em;
  }
  .fam-intro { font-size: 0.9rem; color: var(--color-ink-soft); }
  .fam-list { margin: 0; display: grid; }
  .fam-list > div {
    display: grid;
    grid-template-columns: 4rem 1fr;
    gap: var(--sp-2) var(--sp-3);
    padding-block: var(--sp-3);
    border-top: 1px solid var(--line);
  }
  .fam-list > div:last-child { border-bottom: 1px solid var(--line); }
  @media (max-width: 30rem) {
    .fam-list > div { grid-template-columns: 1fr; gap: var(--sp-1); }
  }
  .fam-list dt {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    color: var(--color-river);
    padding-top: 0.35em;
  }
  .fam-list dd { margin: 0; display: grid; gap: 0.35rem; }
  .fam-name {
    font-family: var(--font-serif);
    font-size: 1rem;
    letter-spacing: 0.08em;
  }
  .fam-rd {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    color: var(--color-ink-soft);
  }
  .fam-note { font-size: 0.85rem; color: var(--color-ink-soft); line-height: 2.1; }

  .links { display: flex; flex-wrap: wrap; gap: var(--sp-4); }
</style>
