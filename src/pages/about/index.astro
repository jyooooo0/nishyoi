---
import Base from '../../layouts/Base.astro';
import AboutNav from '../../components/AboutNav.astro';
import PhotoFrame from '../../components/PhotoFrame.astro';
import RiverLine from '../../components/RiverLine.astro';
import aerialValley from '../../assets/photos/aerial-valley.jpg';

const description =
  'ニショイは、山形県鶴岡市関川で続けている、暮らしの実験と記録の屋号です。里山の知恵と新しい技術を組み合わせて、未完成な暮らしを続けていきます。';

const activities = [
  {
    cat: '季節と手仕事',
    body: '家庭菜園に山菜採り、薪割り、雪かき。季節ごとの仕事を、集落のやり方を教わりながら覚えているところです。',
  },
  {
    cat: '動物と暮らし',
    body: 'いまは保護した猫二匹と暮らしています。いずれはニワトリやヤギも迎えたい。暮らしのなかに、動物の時間を取り戻したいんです。',
  },
  {
    cat: '田舎とテクノロジー',
    body: '衛星データやAIで舞茸の出そうな山を探したり。新しい技術を、山仕事の道具として試しています。',
  },
  {
    cat: 'イベント',
    body: '二十四節気ごとのフォトウォークや、暮らしの一部をそのまま味わってもらうオープンデイを開いています。',
  },
  {
    cat: '発信と仕事',
    body: '写真・映像・Webでこの暮らしを記録しつつ、小さな事業のWeb制作も仕事にしています。',
  },
];
---

<Base title="ニショイについて" description={description}>
  <article class="about">
    <header class="container head">
      <div class="heading-pair">
        <span class="en">About NISHYOI</span>
        <h1 class="t-display">ニショイについて</h1>
      </div>
      <AboutNav />
    </header>

    <div class="container body">
      <p class="lead reveal">
        ニショイは、山形の山あいの集落・関川で続けている、<br class="pc" />暮らしの実験と記録です。
      </p>

      <section class="block reveal">
        <h2 class="t-section">屋号「にしょい」のこと</h2>
        <p>
          ニショイって変わった名前ですが、じつは僕の実家の屋号なんです。
          正式には「仁兵衛(にへえ)」。それが集落のなかで訛って、
          みんなから「にしょい」と呼ばれてきました。
          ご近所がうちを呼んできたその名前を、そのまま活動の名前にしています。
        </p>
      </section>

      <section class="block reveal">
        <p>
          関川は、山あいの小さな集落です。人はだんだん減って、
          昔からの暮らしの手ざわりも、少しずつ薄れてきています。
          このまま行くと、いつかこの集落自体がなくなるかもしれない。
          大げさな話じゃなくて、けっこう目の前にある現実です。
        </p>
      </section>

      <PhotoFrame
        ratio="21/9"
        src={aerialValley}
        alt="上空から見た関川。山に囲まれた谷あいに家々が並ぶ(2025年12月撮影)"
        focal="50% 40%"
        class="wide-photo"
        sizes="(max-width: 48rem) 100vw, 46rem"
      />

      <section class="block reveal">
        <span class="en">Project Theme</span>
        <h2 class="t-section">「未完成な暮らし」</h2>
        <p>
          私たちニショイの活動の根っこにあるのは、効率化が加速する社会のなかで、
          「便利さを追い求め過ぎること」と「田舎の不便さを美徳として抱え込み過ぎること」、
          その両極のどちらにも振り切れることなく、あいだで絶妙なバランスを保ちながら
          アップデートを重ねていく、という姿勢です。
          テクノロジーの力を積極的に取り入れつつ、山や川、風土が授けてくれる自然資源を
          最大限に活かし、両者の相乗効果を探り続ける。そして、刻々と変化する社会情勢のなかで、
          その時々の"最適解"を柔軟に模索し続ける。
        </p>
        <p>
          私たちにとって「完成」はゴールではありません。
          むしろ変化そのものを楽しみ、試行錯誤を重ねながら暮らしを進化させていく。
          何か一つに傾いて突き進むのは、簡単でわかりやすい。
          でも本当に大切なのは、バランスを取りながらアップデートし続けることだと思っています。
        </p>
        <p class="theme-close">
          そうやって、"未完成"という余白を一緒に面白がってくれる仲間が増えたら、
          この場所はきっと、もっと面白くなるはずです。
        </p>
      </section>

      <section class="block reveal">
        <h2 class="t-section">里山の知恵と、新しい技術</h2>
        <p>
          手がかりは、二つあると思っています。
          ひとつは、山菜の採り方や薪の扱い、雪とのつきあい方みたいな、
          この土地に受け継がれてきた里山の知恵。
          もうひとつは、衛星データやAI、Webみたいな新しい技術。
          どっちか片方に寄りかからず、両方を組み合わせて、
          小さな暮らしでも続けていける形を探しています。
        </p>
      </section>

      <section class="block reveal">
        <h2 class="t-section">うまくいけばモデルに、だめでも記録に</h2>
        <p>
          うまくいけば、同じような場所で暮らしたい誰かの、ひとつの手がかりになるかもしれません。
          もしうまくいかなくても、撮って書いて残した記録は、
          この集落に確かに暮らしがあったことを伝えてくれる。
          だから、やってみることと記録することは、いつもセットで進めています。
        </p>
      </section>
    </div>

    <RiverLine variant={2} />

    <div class="container acts">
      <div class="heading-pair reveal">
        <span class="en">Activities</span>
        <h2 class="t-section">現在の取り組み</h2>
      </div>
      <dl class="act-list">
        {activities.map((a, i) => (
          <div class="act reveal" style={`--stagger:${i * 90}ms`}>
            <dt>{a.cat}</dt>
            <dd>{a.body}</dd>
          </div>
        ))}
      </dl>
    </div>

    <div class="container">
      <section class="family reveal">
        <div class="heading-pair">
          <span class="en">Family</span>
          <h2 class="t-section">この家族で暮らしています</h2>
        </div>
        <dl class="fam-list">
          <div>
            <dt>オット</dt>
            <dd>
              <span class="fam-name"><a href="/about/jo/">五十嵐 丈</a></span>
              <span class="fam-note">写真とWeb。1993年、関川生まれ。</span>
            </dd>
          </div>
          <div>
            <dt>ツマ</dt>
            <dd>
              <span class="fam-name"><a href="/about/satsuki/">五十嵐 颯稀</a></span><span class="fam-rd">さつき</span>
              <span class="fam-note">イラストと筆文字、エッセイ。ニショイの絵と文字はさつきが書いています。</span>
            </dd>
          </div>
          <div>
            <dt>チョウナン</dt>
            <dd>
              <span class="fam-name">五十嵐 旦旦</span><span class="fam-rd">たんたん / 保護猫</span>
              <span class="fam-note">2024年の元旦、妻の実家に帰省した初日の出の朝、ひとりで歩いていたところを保護しました。</span>
            </dd>
          </div>
          <div>
            <dt>ジナン</dt>
            <dd>
              <span class="fam-name">五十嵐 菅菅</span><span class="fam-rd">かんかん / 保護猫</span>
              <span class="fam-note">2025年10月ごろ、菅野代のトンネルのあたりに、ふらりと現れるようになりました。</span>
            </dd>
          </div>
          <div>
            <dt>サンナン</dt>
            <dd>
              <span class="fam-name">五十嵐 希糸</span><span class="fam-rd">きいと</span>
              <span class="fam-note">2026年5月に生まれました。</span>
            </dd>
          </div>
        </dl>
      </section>
    </div>

    <div class="container closing">
      <p class="closing-lead reveal">
        そもそも、なぜこんなことを始めたのか。
        銀行を辞めた日のことや、この土地への思いは、丈のプロフィールに書きました。
      </p>
      <div class="next reveal" style="--stagger:90ms">
        <a class="link-line" href="/about/jo/">丈のプロフィールを読む <span aria-hidden="true">→</span></a>
        <a class="link-line" href="/about/satsuki/">さつきのプロフィールを読む <span aria-hidden="true">→</span></a>
        <a class="link-line" href="/about/sekigawa/">関川集落について <span aria-hidden="true">→</span></a>
        <a class="link-line" href="/about/iei/">集落の遺影(写真) <span aria-hidden="true">→</span></a>
        <a class="link-line" href="https://kotograph-joe.com/" target="_blank" rel="noopener">KOTOGRAPH <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </article>
</Base>

<style>
  .about { padding-block: calc(var(--space-section) + var(--sp-4)) var(--space-section); }
  .head { display: grid; gap: var(--sp-4); margin-bottom: var(--sp-5); }
  .body { display: grid; gap: var(--sp-5); max-width: 46rem; }
  .lead {
    font-family: var(--font-serif);
    font-size: clamp(1.05rem, 2vw, 1.25rem);
    letter-spacing: 0.1em;
    line-height: 2.4;
  }
  .pc { display: none; }
  @media (min-width: 40rem) { .pc { display: inline; } }
  .block { display: grid; gap: var(--sp-3); }
  .block p {
    font-size: 0.92rem;
    color: var(--color-ink-soft);
    line-height: 2.3;
    max-width: 40em;
  }
  .block a { color: var(--color-river); text-underline-offset: 4px; }
  .block > .en { display: block; margin-bottom: 0.2rem; }
  /* テーマの締め。囲みにはせず、地の文のなかで少しだけ強調する */
  .block .theme-close {
    font-family: var(--font-serif);
    font-size: clamp(1rem, 2vw, 1.15rem);
    letter-spacing: 0.06em;
    line-height: 2.3;
    color: var(--color-ink);
    max-width: 34em;
  }
  .wide-photo { margin-block: var(--sp-2); }

  /* 家族 */
  .family { display: grid; gap: var(--sp-3); max-width: 46rem; margin-bottom: var(--space-section); }
  .fam-list { margin: 0; display: grid; }
  .fam-list > div {
    display: grid;
    grid-template-columns: 5rem 1fr;
    gap: var(--sp-2) var(--sp-3);
    padding-block: var(--sp-3);
    border-top: 1px solid var(--line);
  }
  .fam-list > div:last-child { border-bottom: 1px solid var(--line); }
  @media (max-width: 30rem) {
    .fam-list > div { grid-template-columns: 1fr; gap: var(--sp-1); }
  }
  .fam-list dt {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    color: var(--color-river);
    padding-top: 0.35em;
  }
  .fam-list dd { margin: 0; display: grid; gap: 0.35rem; }
  .fam-name {
    font-family: var(--font-serif);
    font-size: 1rem;
    letter-spacing: 0.08em;
  }
  .fam-name a { color: var(--color-river); text-underline-offset: 4px; }
  .fam-rd {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    color: var(--color-ink-soft);
  }
  .fam-note { font-size: 0.85rem; color: var(--color-ink-soft); line-height: 2.1; }

  .acts { display: grid; gap: var(--sp-4); margin-block: var(--space-section); }
  .act-list {
    margin: 0;
    display: grid;
    gap: 0;
    max-width: 46rem;
  }
  .act {
    display: grid;
    grid-template-columns: minmax(9rem, 13rem) 1fr;
    gap: var(--sp-3);
    padding-block: var(--sp-3);
    border-top: 1px solid var(--line);
  }
  .act:last-child { border-bottom: 1px solid var(--line); }
  @media (max-width: 40rem) {
    .act { grid-template-columns: 1fr; gap: var(--sp-1); }
  }
  .act dt {
    font-family: var(--font-serif);
    letter-spacing: 0.12em;
    font-size: 0.95rem;
  }
  .act dd {
    margin: 0;
    font-size: 0.85rem;
    color: var(--color-ink-soft);
    line-height: 2.1;
  }

  .closing { display: grid; gap: var(--sp-3); margin-top: var(--space-section); max-width: 46rem; }
  .closing-lead {
    font-family: var(--font-serif);
    font-size: clamp(1rem, 2vw, 1.15rem);
    letter-spacing: 0.06em;
    line-height: 2.2;
  }
  .next {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-4);
  }
</style>
