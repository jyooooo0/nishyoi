---
import Base from '../layouts/Base.astro';
import RiverLine from '../components/RiverLine.astro';
---

<Base title="ページが見つかりません">
  <section class="nf">
    <div class="container">
      <p class="t-data code">404</p>
      <h1 class="t-section">ページが見つかりません</h1>
      <p class="text">
        道が途切れているようです。URLが変わったか、削除された可能性があります。
      </p>
      <a class="link-line" href="/">トップへ戻る <span aria-hidden="true">→</span></a>
    </div>
    <RiverLine variant={3} />
  </section>
</Base>

<style>
  .nf { padding-block: calc(var(--space-section) + var(--sp-5)) var(--space-section); min-height: 55vh; }
  .nf .container { display: grid; gap: var(--sp-3); max-width: 40rem; }
  .code { color: var(--color-river); letter-spacing: 0.4em; }
  .text { font-size: 0.9rem; color: var(--color-ink-soft); line-height: 2.2; }
</style>
