---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../layouts/Base.astro';
import PhotoFrame from '../components/PhotoFrame.astro';
import RiverLine from '../components/RiverLine.astro';
import SekkiStrip from '../components/SekkiStrip.astro';
import { EVENT_STATUS } from '../lib/constants';
import { currentSekki } from '../lib/sekki';
import { nowPhoto } from '../lib/nowPhoto';
import heroSummer from '../assets/photos/hero-summer.jpg';
import heroAutumn from '../assets/photos/hero-autumn.jpg';
import heroWinter from '../assets/photos/hero-winter.jpg';
import heroEarlySpring from '../assets/photos/hero-earlyspring.jpg';
import aerialValley from '../assets/photos/aerial-valley.jpg';
import teshigotoDrying from '../assets/photos/teshigoto-drying.jpg';
import recordInaboshi from '../assets/photos/record-inaboshi.jpg';
import workForest from '../assets/photos/work-forest.jpg';
import joPortrait from '../assets/photos/jo-portrait.jpg';

// ヒーロー: 関川の四季(現在の季節を先頭に、ゆっくりクロスフェード)
const heroSlides = [
  { img: heroEarlySpring, season: 'spring', alt: '雪解けが進む早春の関川(2026年3月撮影)' },
  { img: heroSummer, season: 'summer', alt: '緑の山あいを川が流れる初夏の関川(2025年6月撮影)' },
  { img: heroAutumn, season: 'autumn', alt: '霧のかかった山と家並み、秋の関川(2025年10月撮影)' },
  { img: heroWinter, season: 'winter', alt: '雪に覆われた集落を上空から、冬の関川(2026年1月撮影)' },
];
const season = currentSekki().season;
while (heroSlides[0]!.season !== season) heroSlides.push(heroSlides.shift()!);

// いまの頃の関川(撮影日がいちばん近い写真)
const now = nowPhoto();

// 募集中のイベント(最大3件)。下書き・終了系は載せない
const events = (await getCollection('events'))
  .filter((e) => ['open', 'soon', 'full'].includes(e.data.status))
  .sort((a, b) => a.data.date.getTime() - b.data.date.getTime())
  .slice(0, 3);
const [featured, ...restEvents] = events;

// トップに出す設定。実コンテンツが増えたらここを true に戻すだけで復活する
const SHOW_ENTRANCES = false; // 「暮らしの入口」4カード(写真と分類が揃ったら true)

// 最新Journal。公開記事(draftでない)がある時だけ「最新の記録」を表示する。
// 仮記事はすべてdraftなので現在は自動的に非表示。実記事を追加すると自動で出る
const journal = (await getCollection('journal'))
  .filter((j) => !j.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 4);

// Web制作の実績(掲載許可済みのみ)
const works = (await getCollection('works')).filter((w) => w.data.published);

// noteの記事引用(本番ではdraft除外)。アカウント自体へのリンクは常設
const NOTE_ACCOUNT = 'https://note.com/joe_igarashi';
const notes = (await getCollection('notes'))
  .filter((n) => !(import.meta.env.PROD && n.data.draft))
  .sort((a, b) => (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0))
  .slice(0, 2);

// 興味本位でつくったホームページ
const labs = (await getCollection('labs')).filter(
  (l) => !(import.meta.env.PROD && l.data.draft)
);

const fmt = (d: Date) =>
  `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`;

type Entrance = {
  label: string; en: string; ratio: string;
  src?: ImageMetadata; alt?: string; focal?: string; note?: string;
};
const entrances: Entrance[] = [
  {
    label: '季節と手仕事', en: 'Seasons & Handwork', ratio: '4/5',
    src: teshigotoDrying, alt: 'ざるに広げて干した実。冬支度の手仕事', focal: '50% 45%',
  },
  {
    label: '動物と暮らし', en: 'Animals & Life', ratio: '1/1',
    note: '撮影予定: ニワトリ/孵卵器',
  },
  {
    label: '田舎とテクノロジー', en: 'Countryside & Technology', ratio: '3/2',
    src: aerialValley, alt: 'ドローンで上空から撮影した関川の谷と家並み', focal: '50% 45%',
  },
  {
    label: '集落の記録', en: 'Village Records', ratio: '4/3',
    src: recordInaboshi, alt: '軒先に稲を干した関川の家', focal: '50% 55%',
  },
];
---

<Base>
  <!-- 1. ファーストビュー: 関川の四季 -->
  <section class="hero">
    <div class="hero-media" role="img" aria-label="関川の四季の風景">
      {heroSlides.map((s, i) => (
        <Image
          class={`hero-slide ${i === 0 ? 'is-first' : ''}`}
          src={s.img}
          alt={i === 0 ? s.alt : ''}
          widths={[768, 1280, 1920]}
          sizes="100vw"
          loading={i === 0 ? 'eager' : 'lazy'}
          fetchpriority={i === 0 ? 'high' : 'auto'}
          style={`--slide: ${i};`}
        />
      ))}
    </div>
    <div class="container hero-under">
      <div class="hero-text">
        <h1><span class="nb">未完成な暮らしを、</span><span class="nb">続けていく。</span></h1>
        <p class="hero-lead">
          昔の暮らしに戻るのではなく、流行に流されるのでもなく。<br class="pc" />
          受け継がれてきた知恵と新しい技術を組み合わせながら、<br class="pc" />
          山の暮らしを、時代とともにアップデートし続ける。
        </p>
      </div>
      <div class="hero-side">
        <SekkiStrip />
        <a class="now-card" href="/about/sekigawa/">
          <Image src={now.img} alt={now.alt} widths={[480, 800]} sizes="(max-width: 48rem) 90vw, 20rem" loading="lazy" />
          <span class="now-meta">
            <span class="t-label">Sekigawa Now</span>
            <span class="now-title">いまの頃の関川 — {now.caption}</span>
            <span class="t-data">{now.taken} 撮影</span>
          </span>
        </a>
      </div>
    </div>
  </section>

  <!-- 2. コンセプト -->
  <section class="section concept">
    <div class="container concept-grid">
      <p class="t-vertical t-label concept-vert reveal" aria-hidden="true">関川 — SEKIGAWA</p>
      <div class="concept-body">
        <div class="heading-pair reveal">
          <span class="en">Concept</span>
          <h2 class="t-section">山あいの暮らしを、<br />記録する。</h2>
        </div>
        <p class="concept-text reveal" style="--stagger:90ms">
          なくなるかもしれないと言われる集落の、試したこと、直したこと、失敗したこと。
          その日々を写真と文章で記録していきます。
          うまくいけば、同じような場所で暮らしたい誰かのモデルに。
          そうでなくても、ここに暮らしがあったことを伝えるアーカイブに。
        </p>
        <a class="link-line reveal" style="--stagger:180ms" href="/about/">NISHYOIについて <span aria-hidden="true">→</span></a>
      </div>
    </div>
    <RiverLine variant={1} />
  </section>

  <!-- 3. 募集中のイベント -->
  {events.length > 0 && (
    <section class="section events" style="background: var(--color-paper-dim);">
      <div class="container">
        <div class="heading-pair reveal">
          <span class="en">Events</span>
          <h2 class="t-section">募集中のイベント</h2>
        </div>
        <div class="events-grid">
          {featured && (
            <a class="event-featured reveal" href={`/events/${featured.id}/`} style="--stagger:90ms">
              <PhotoFrame
                ratio="3/2"
                src={featured.data.image}
                alt={featured.data.imageAlt ?? ''}
                focal="50% 55%"
                note={`撮影予定: ${featured.data.sekki ?? ''}のイベント風景`}
                sizes="(max-width: 48rem) 90vw, 40vw"
              />
              <div class="event-meta">
                <span class="badge" data-state={featured.data.status}>{EVENT_STATUS[featured.data.status]}</span>
                <span class="t-data">{fmt(featured.data.date)}</span>
                {featured.data.sekki && <span class="t-data sekki-tag">{featured.data.sekki}</span>}
                {featured.data.remaining != null && featured.data.status === 'open' && (
                  <span class="t-data">残席 {featured.data.remaining}</span>
                )}
              </div>
              <h3 class="event-title">{featured.data.title}</h3>
              <p class="event-summary">{featured.data.summary}</p>
            </a>
          )}
          <div class="event-list">
            {restEvents.map((e, i) => (
              <a class="event-row reveal" href={`/events/${e.id}/`} style={`--stagger:${180 + i * 90}ms`}>
                <div class="event-meta">
                  <span class="badge" data-state={e.data.status}>{EVENT_STATUS[e.data.status]}</span>
                  <span class="t-data">{fmt(e.data.date)}</span>
                  {e.data.sekki && <span class="t-data sekki-tag">{e.data.sekki}</span>}
                </div>
                <h3 class="event-title">{e.data.title}</h3>
              </a>
            ))}
            <a class="link-line reveal" style={`--stagger:${180 + restEvents.length * 90}ms`} href="/events/">すべてのイベント <span aria-hidden="true">→</span></a>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- 4. 暮らしの4つの入口(SHOW_ENTRANCES=true で復活。写真と分類が揃ったら戻す) -->
  {SHOW_ENTRANCES && (
  <section class="section entrances">
    <div class="container">
      <div class="heading-pair reveal">
        <span class="en">Ways In</span>
        <h2 class="t-section">暮らしの入口</h2>
      </div>
      <div class="entrance-grid">
        {entrances.map((ent, i) => (
          <a
            class="entrance"
            href="/journal/"
            style={`--stagger:${i * 90}ms`}
          >
            <PhotoFrame
              ratio={ent.ratio}
              src={ent.src}
              alt={ent.alt ?? ''}
              focal={ent.focal}
              note={ent.note ?? ''}
              sizes="(max-width: 40rem) 90vw, 45vw"
            />
            <span class="ent-en t-label">{ent.en}</span>
            <span class="ent-ja">{ent.label}</span>
          </a>
        ))}
      </div>
    </div>
    <RiverLine variant={2} />
  </section>
  )}

  <!-- 5. 最新Journal(コンタクトシート) -->
  {journal.length > 0 && (
    <section class="section journal">
      <div class="container">
        <div class="heading-pair reveal">
          <span class="en">Journal</span>
          <h2 class="t-section">最新の記録</h2>
        </div>
        <div class="sheet" role="list">
          {journal.map((j, i) => (
            <a class="frame reveal" role="listitem" href={`/journal/${j.id}/`} style={`--stagger:${i * 90}ms`}>
              <PhotoFrame
                ratio="3/2"
                src={j.data.image}
                alt={j.data.imageAlt ?? ''}
                note="記事写真"
                reveal={false}
                sizes="(max-width: 40rem) 70vw, 22vw"
              />
              <div class="frame-no t-data">
                <span>No.{String(journal.length - i).padStart(3, '0')}</span>
                <span>{j.data.sekki ?? ''}</span>
              </div>
              <h3 class="frame-title">{j.data.title}</h3>
              <div class="frame-meta t-data">
                <span>{fmt(j.data.date)}</span>
                <span class="frame-cat">{j.data.category}</span>
              </div>
            </a>
          ))}
        </div>
        <a class="link-line reveal" href="/journal/">記録をすべて読む <span aria-hidden="true">→</span></a>
      </div>
    </section>
  )}

  <!-- 5.5 noteの記事 -->
  <section class="section-tight notes-corner">
    <div class="container">
      <div class="heading-pair reveal">
        <span class="en">Note</span>
        <h2 class="t-section">noteでも書いています</h2>
      </div>
      <div class="notes-grid">
        {notes.map((n, i) => (
          <a class="note-card reveal" href={n.data.url} target="_blank" rel="noopener" style={`--stagger:${i * 90}ms`}>
            <PhotoFrame
              ratio="1.91/1"
              src={n.data.image}
              alt={`note記事「${n.data.title}」`}
              note="note記事"
              reveal={false}
              class="note-shot"
              sizes="(max-width: 48rem) 90vw, 22rem"
            />
            <span class="note-title">{n.data.title} <span aria-hidden="true">↗</span></span>
          </a>
        ))}
        <a class="note-account reveal" href={NOTE_ACCOUNT} target="_blank" rel="noopener" style={`--stagger:${notes.length * 90}ms`}>
          <span class="note-account-inner">
            <span class="t-label">note.com</span>
            <span class="note-account-name">joe_igarashi</span>
            <span class="note-account-cap">写真や暮らしのこと、少し長い文章はこちらに <span aria-hidden="true">↗</span></span>
          </span>
        </a>
      </div>
    </div>
  </section>

  <!-- 6. 丈のプロフィール -->
  <section class="section profile" style="background: var(--color-paper-dim);">
    <div class="container profile-grid">
      <PhotoFrame
        ratio="4/5"
        src={joPortrait}
        alt="五十嵐丈のポートレート"
        focal="50% 38%"
        class="profile-photo"
        sizes="(max-width: 48rem) 90vw, 26rem"
      />
      <div class="profile-body">
        <div class="heading-pair reveal">
          <span class="en">Profile</span>
          <h2 class="t-section">五十嵐 丈<span class="t-data" style="margin-left:1em; letter-spacing:.2em;">JO IGARASHI</span></h2>
        </div>
        <p class="profile-text reveal" style="--stagger:90ms">
          1993年、鶴岡市関川生まれ。大学進学で一度地域を離れ、卒業後は銀行勤務を経験。
          その後、自然体験プログラムや、しな織・しなの花を活用した地域事業に携わる。
          現在はそれらのプロジェクトを離れ、写真家として活動しながら、
          生まれ育った集落で、暮らしそのものを起点にしたNISHYOIを始めている。
        </p>
        <div class="profile-links reveal" style="--stagger:180ms">
          <a class="link-line" href="/about/jo/">プロフィール <span aria-hidden="true">→</span></a>
          <a class="link-line" href="https://kotograph-joe.com/" target="_blank" rel="noopener">KOTOGRAPH(写真の仕事) <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </div>
  </section>

  <RiverLine variant={3} />

  <!-- 7. Web制作 -->
  <section class="section web-works">
    <div class="container">
      <div class="heading-pair reveal">
        <span class="en" style="color: var(--color-night-ink); opacity:.7;">Web Works</span>
        <h2 class="t-section">小さな事業の、Webをつくる</h2>
      </div>
      <div class="web-grid">
        <p class="web-text reveal" style="--stagger:90ms">
          庄内の小規模事業者・店舗・作家・地域プロジェクト、
          そして全国の過疎地域で小さな事業を始める人へ。
          魅力の整理から、写真撮影、文章、Web制作、予約や問い合わせの導線まで、
          発信のかたちを一緒につくります。
        </p>
        <div class="web-side reveal" style="--stagger:180ms">
          {works.length > 0 ? (
            <ul class="web-list">
              {works.map((w) => (
                <li><a href={`/works/${w.id}/`}>{w.data.title}</a></li>
              ))}
            </ul>
          ) : (
            <p class="t-data" style="opacity:.6;">制作実績は掲載許可の確認後に公開します。</p>
          )}
          <a class="link-line" href="/works/">Web制作について <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>
  </section>

  <!-- 7.5 興味本位でつくったもの -->
  {labs.length > 0 && (
    <section class="section playground">
      <div class="container">
        <div class="heading-pair reveal">
          <span class="en">Playground</span>
          <h2 class="t-section">興味本位でつくったもの</h2>
        </div>
        <p class="pg-lead reveal" style="--stagger:90ms">
          仕事とは別に、気になったことを形にしてみた小さなホームページたち。
        </p>
        <div class="pg-grid">
          {labs.map((l, i) => (
            l.data.url ? (
              <a class="pg-card reveal" href={l.data.url} target="_blank" rel="noopener" style={`--stagger:${i * 90}ms`}>
                <span class="pg-url t-data">{new URL(l.data.url).host} <span aria-hidden="true">↗</span></span>
                <span class="pg-title">{l.data.title}</span>
                <span class="pg-desc">{l.data.description}</span>
              </a>
            ) : (
              <div class="pg-card reveal" style={`--stagger:${i * 90}ms`}>
                <span class="pg-url t-data">準備中</span>
                <span class="pg-title">{l.data.title}</span>
                <span class="pg-desc">{l.data.description}</span>
              </div>
            )
          ))}
        </div>
      </div>
    </section>
  )}

  <!--
    8-9. 将来枠: Films(YouTube開始後) / Shop(販売開始後)
    データコレクションを追加した時点でここにセクションを差し込む。
    空のセクション・ナビは公開しない方針。
  -->
</Base>

<style>
  /* ---------- hero: 四季のクロスフェード ---------- */
  .hero {
    position: relative;
    padding-top: 0;
  }
  .hero-media {
    position: relative;
    overflow: hidden;
    height: min(88svh, 200vw);
    background: var(--color-paper-dim);
  }
  @media (min-width: 48rem) {
    .hero-media { height: 78vh; }
  }
  .hero-media :global(img.hero-slide) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    /* 4枚×9秒=36秒でひとまわり。季節がゆっくり入れ替わる */
    animation: hero-cycle 36s linear infinite;
    animation-delay: calc(var(--slide) * 9s);
  }
  .hero-media :global(img.hero-slide.is-first) {
    animation-name: hero-cycle-first;
  }
  @keyframes hero-cycle {
    0% { opacity: 0; }
    4% { opacity: 1; }
    25% { opacity: 1; }
    29% { opacity: 0; }
    100% { opacity: 0; }
  }
  /* 先頭の1枚だけ、最初から表示された状態で始める */
  @keyframes hero-cycle-first {
    0% { opacity: 1; }
    25% { opacity: 1; }
    29% { opacity: 0; }
    96% { opacity: 0; }
    100% { opacity: 1; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-media :global(img.hero-slide) { animation: none; }
    .hero-media :global(img.hero-slide.is-first) { opacity: 1; }
  }

  /* 写真の下に、静かにコンセプトを置く(大きなキャッチの重なりはやめる) */
  .hero-under {
    display: grid;
    grid-template-columns: 1fr minmax(16rem, 21rem);
    gap: var(--sp-4) var(--sp-5);
    align-items: start;
    padding-block: var(--sp-4) 0;
  }
  @media (max-width: 48rem) {
    .hero-under { grid-template-columns: 1fr; }
  }
  .hero-side { display: grid; gap: var(--sp-3); align-content: start; }
  .now-card {
    text-decoration: none;
    display: grid;
    gap: var(--sp-1);
    border: 1px solid var(--line);
    background: var(--color-paper);
    padding: var(--sp-1);
  }
  .now-card :global(img) {
    width: 100%;
    aspect-ratio: 3/2;
    height: auto;
    object-fit: cover;
  }
  .now-meta { display: grid; gap: 0.15rem; padding: var(--sp-1) var(--sp-1) var(--sp-1); }
  .now-title {
    font-family: var(--font-serif);
    font-size: 0.88rem;
    letter-spacing: 0.1em;
    transition: color var(--dur-micro);
  }
  .now-card:hover .now-title { color: var(--color-river); }
  .now-meta .t-data { color: var(--color-ink-soft); }
  .hero-text { display: grid; gap: var(--sp-3); }
  .hero-text h1 {
    font-size: clamp(1.4rem, 3vw, 2rem);
    letter-spacing: 0.16em;
  }
  .hero-text .nb { display: inline-block; }
  .hero-lead {
    font-size: 0.9rem;
    color: var(--color-ink-soft);
    line-height: 2.3;
  }
  .pc { display: none; }
  @media (min-width: 48rem) { .pc { display: inline; } }

  /* ---------- concept ---------- */
  .concept-grid {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: clamp(var(--sp-4), 6vw, var(--sp-5));
    align-items: start;
  }
  .concept-vert {
    border-left: 1px solid var(--line);
    padding-left: var(--sp-2);
    min-height: 12rem;
  }
  .concept-body { display: grid; gap: var(--sp-3); max-width: 40em; }
  .concept-text { color: var(--color-ink-soft); font-size: 0.92rem; }
  @media (max-width: 40rem) {
    .concept-grid { grid-template-columns: 1fr; }
    .concept-vert { display: none; }
  }

  /* ---------- events ---------- */
  .events .heading-pair { margin-bottom: var(--sp-4); }
  .events-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: clamp(var(--sp-4), 4vw, var(--sp-5));
    align-items: start;
  }
  @media (max-width: 48rem) {
    .events-grid { grid-template-columns: 1fr; }
  }
  .event-featured { text-decoration: none; display: grid; gap: var(--sp-2); }
  .event-meta { display: flex; align-items: center; gap: var(--sp-2); flex-wrap: wrap; margin-top: 0.4rem; }
  .sekki-tag { color: var(--season); }
  .event-title {
    font-size: 1.05rem;
