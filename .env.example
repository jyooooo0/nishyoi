# イベント申込みフォームの送信先。設定するまでフォームは「準備中」エラーを返す。
# ローカル: このファイルを .env にコピーして値を入れる(.envはコミットしない)
# 本番: Cloudflare Pages → Settings → Environment variables に同名で登録

# Supabase (Project Settings → API)
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Resend (確認メール送信) https://resend.com
RESEND_API_KEY=
# 送信元。ドメイン認証後は info@nishyoi.com を使う
RESEND_FROM_EMAIL=NISHYOI <onboarding@resend.dev>

# 申込み通知を受け取る管理者メール
OWNER_EMAIL=jmfs24@gmail.com
